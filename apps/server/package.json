{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --ignore-watch drizzle,db.sqlite,dist src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "e2b:template:create": "npx tsx ./e2b-template/build.prod.ts",
    "e2b:template:create:dev": "npx tsx ./e2b-template/build.dev.ts"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^1.2.0",
    "@langchain/community": "^0.2.33",
    "@langchain/core": "^0.2.36",
    "@langchain/openai": "^0.2.11",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "langchain": "^0.2.20",
    "uuid": "^9.0.0",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "@opencode-ai/sdk": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "e2b": "^2.3.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
